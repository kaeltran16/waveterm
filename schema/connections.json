{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ConnKeywords": {
      "properties": {
        "display:order": {
          "type": "number"
        },
        "term:*": {
          "type": "boolean"
        },
        "term:fontsize": {
          "type": "number"
        },
        "term:fontfamily": {
          "type": "string"
        },
        "cmd:env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "cmd:initscript": {
          "type": "string"
        },
        "cmd:initscript.sh": {
          "type": "string"
        },
        "cmd:initscript.bash": {
          "type": "string"
        },
        "cmd:initscript.zsh": {
          "type": "string"
        },
        "cmd:initscript.pwsh": {
          "type": "string"
        },
        "cmd:initscript.fish": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/ConnKeywords"
  },
  "type": "object"
}